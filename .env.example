MYSQL_DATABASE=shijie_accessibility
MYSQL_PORT=3306
# 数据库与缺陷演示应用默认只监听本机；隔离实验环境才应修改绑定地址
MYSQL_BIND_HOST=127.0.0.1
MYSQL_USER=shijie
MYSQL_PASSWORD=shijie-dev
MYSQL_ROOT_PASSWORD=root-dev-only
DEMO_MYSQL_BIND_HOST=127.0.0.1
DEMO_BIND_HOST=127.0.0.1
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/shijie_accessibility?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=shijie
SPRING_DATASOURCE_PASSWORD=shijie-dev
SERVER_BIND_HOST=127.0.0.1
APP_STORAGE_ROOT=./data
APP_HOSTING_GATEWAY_PORT=8090
APP_HOSTING_WORKER_PORT=18091
# 首次启动会创建该本机管理员；共享部署前必须更换密码和凭据加密密钥
APP_INITIAL_ADMIN_USERNAME=admin
APP_INITIAL_ADMIN_PASSWORD=change-me-on-first-run
APP_INITIAL_ADMIN_DISPLAY_NAME=系统管理员
APP_CREDENTIAL_KEY=local-development-key-change-before-deployment
ZAP_IMAGE=zaproxy/zap-stable:2.16.1
K6_IMAGE=grafana/k6:0.57.0
SCANNER_MAX_PAGES=10
SCANNER_PAGE_TIMEOUT_MS=10000
SCANNER_TOTAL_TIMEOUT_MS=60000
AI_ENABLED=false
AI_PROVIDER=qwen
# 在百炼控制台创建 Workspace 后填写北京区域的兼容模式地址，例如：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
# 仅在本机 .env 或部署环境中填写，绝不提交真实密钥
AI_API_KEY=
AI_MODEL=qwen3-vl-plus
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
APP_HOSTING_NETWORK_PREFIX=10.253
